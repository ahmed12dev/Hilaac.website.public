# ─────────────────────────────────────────────────────────────
# Xisbiga Hilaac — public website environment
# ─────────────────────────────────────────────────────────────

# Base URL of the existing Node.js + PostgreSQL admin backend.
# The site calls <API_BASE>/api/public/* for all CMS content.
# Leave empty to run the site on bundled fallback content.
NEXT_PUBLIC_API_BASE=https://www.xisbiga-hilaac.com

# Canonical public URL (used for SEO metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.xisbiga-hilaac.com

# Where the "Join the Party" buttons send visitors (existing registration app).
NEXT_PUBLIC_REGISTER_URL=https://www.xisbiga-hilaac.com/register.html

# Seconds to cache API responses on the server (ISR / fetch revalidate).
NEXT_PUBLIC_REVALIDATE=300

# --- Website admin (its own accounts + content, site_* tables) ---
# Same PostgreSQL server as the registration system, separate tables.
DATABASE_URL=postgres://user:pass@host:5432/db

# Creates the FIRST admin account only. Ignored once one exists.
SITE_ADMIN_EMAIL=you@example.com
SITE_ADMIN_PASSWORD=use-a-long-password
