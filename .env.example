# ─────────────────────────────────────────────────────────────
# Xisbiga Hilaac — public website
# Set these in Railway → your service → Variables
# ─────────────────────────────────────────────────────────────

# --- Database (required) -------------------------------------
# The website's own PostgreSQL database. Every table it creates is prefixed
# `site_` and belongs to this website alone; the registration system's tables
# are never read or written from here.
DATABASE_URL=postgres://user:pass@host:5432/db

# --- Admin sign-in (required) --------------------------------
# Seeds the FIRST administrator account. Once that account exists, further
# administrators are added from the dashboard and these are only used as a
# fallback when the database is unreachable.
#
# There is no default. If these are unset, nobody can sign in — which is the
# correct behaviour for a public repository.
SITE_ADMIN_EMAIL=you@example.com
SITE_ADMIN_PASSWORD=use-a-long-password

# Signs the fallback session token used when the database is down.
# Set it to a long random string. If unset, SITE_ADMIN_PASSWORD is used.
AUTH_SECRET=

# --- Public URLs ---------------------------------------------
# This site's own public URL — used for SEO metadata, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://hilaac-public-site-production-b22a.up.railway.app

# The registration backend. Live member totals are read from it, and /join
# submissions are forwarded to it. Leave empty to run fully standalone.
NEXT_PUBLIC_API_BASE=https://www.xisbiga-hilaac.com

# Send "Join the party" to the standalone registration app instead of this
# site's own /join page. Leave unset to use /join.
NEXT_PUBLIC_REGISTER_URL=

# Seconds to cache upstream API responses on the server.
NEXT_PUBLIC_REVALIDATE=300

# --- Build ----------------------------------------------------
# Railway sets NODE_ENV=production, which makes `npm ci` skip devDependencies.
# TypeScript and Tailwind live there and `next build` needs both, so the install
# command in nixpacks.toml passes --include=dev. Setting this as well is belt
# and braces.
NPM_CONFIG_PRODUCTION=false
