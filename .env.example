# ─────────────────────────────────────────────────────────────
# Xisbiga Hilaac — public website
# Set these in your host's dashboard (Vercel → Settings → Environment Variables)
# ─────────────────────────────────────────────────────────────

# The registration backend. The website reads live member totals from it and
# forwards /join submissions into the same PostgreSQL database.
NEXT_PUBLIC_API_BASE=https://www.xisbiga-hilaac.com

# This site's own public URL — used for SEO metadata, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Where /admin sends administrators.
NEXT_PUBLIC_ADMIN_URL=https://www.xisbiga-hilaac.com/admin.html

# Seconds before live figures are refetched.
NEXT_PUBLIC_REVALIDATE=30

# Optional: send "Join" buttons to the standalone registration app instead of
# this site's own /join form.
# NEXT_PUBLIC_REGISTER_URL=https://www.xisbiga-hilaac.com/register.html
